root@ubuntu-vm:/opt/ness_relay_rust/configs# cat devices.conf 
# ═══════════════════════════════════════════════════════════
# NESS RELAY — Configuración de Dispositivos
# Generado automáticamente el mar 24 mar 2026 08:42:48 -05
# ═══════════════════════════════════════════════════════════
# 
# Soporta SNMPv1, SNMPv2c y SNMPv3
# 
# Para SNMPv1 (Legacy — sin seguridad):
#   <vendor>_<num>_snmp_version=1
#   <vendor>_<num>_community=<string>
# 
# Para SNMPv2c (Sin cifrado):
#   <vendor>_<num>_snmp_version=2c
#   <vendor>_<num>_community=<string>
# 
# Para SNMPv3 (RECOMENDADO — con autenticación y cifrado):
#   <vendor>_<num>_snmp_version=3
#   <vendor>_<num>_v3_user=<username>
#   <vendor>_<num>_v3_auth_protocol=SHA|MD5|NONE
#   <vendor>_<num>_v3_auth_password=<password>
#   <vendor>_<num>_v3_priv_protocol=AES128|AES192|AES256|DES|NONE
#   <vendor>_<num>_v3_priv_password=<password>
# 
# ═══════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────
# Dispositivos pfsense
# ─────────────────────────────────────────────────────────
pfsense_count=1

# Dispositivo 1: 
pfsense_1_ip=10.0.0.1
pfsense_1_port=161
pfsense_1_vendor=pfsense
pfsense_1_description=
pfsense_1_snmp_version=3
pfsense_1_v3_user=ness_user
pfsense_1_v3_auth_protocol=SHA
pfsense_1_v3_auth_password=NessD*2026
pfsense_1_v3_priv_protocol=AES128
pfsense_1_v3_priv_password=NessD*2026